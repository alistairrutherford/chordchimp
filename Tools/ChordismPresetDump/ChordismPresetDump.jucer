<?xml version="1.0" encoding="UTF-8"?>

<!-- Writes Chordism's factory presets and parameter defaults as JSON (PLAN.md §8, the preset
     fixture). Built by Tools/dump_chordism_presets.sh, which puts the Chordism checkout in place
     of CHORDISM_DIR and the JUCE modules in place of JUCE_MODULES in a copy of this file. -->
<JUCERPROJECT id="CchpPd" name="ChordismPresetDump" projectType="consoleapp" useAppConfig="0"
              addUsingNamespaceToJuceHeader="0" jucerFormatVersion="1" version="0.1.0"
              cppLanguageStandard="17">
  <MAINGROUP id="pdMain" name="ChordismPresetDump">
    <GROUP id="pdSrc" name="Source">
        <FILE id="pdF000" name="Main.cpp" compile="1" resource="0" file="Main.cpp"/>
        <FILE id="pdF001" name="Parameters.cpp" compile="1" resource="0" file="CHORDISM_DIR/Source/plugin/Parameters.cpp"/>
        <FILE id="pdF002" name="FactoryPresets.cpp" compile="1" resource="0" file="CHORDISM_DIR/Source/plugin/FactoryPresets.cpp"/>
    </GROUP>
  </MAINGROUP>
  <MODULES>
    <MODULE id="juce_audio_basics" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_audio_devices" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_audio_formats" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_audio_processors" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_audio_processors_headless" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_core" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_data_structures" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_events" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_graphics" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_gui_basics" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
    <MODULE id="juce_gui_extra" showAllCode="1" useLocalCopy="0" useGlobalPath="0"/>
  </MODULES>
  <JUCEOPTIONS JUCE_STRICT_REFCOUNTEDPOINTER="1" JUCE_WEB_BROWSER="0" JUCE_USE_CURL="0"/>
  <EXPORTFORMATS>
    <XCODE_MAC targetFolder="Builds/MacOSX">
      <CONFIGURATIONS>
        <CONFIGURATION isDebug="0" name="Release" targetName="ChordismPresetDump" macOSDeploymentTarget="12.0"
                       osxArchitecture="Native" headerPath="CHORDISM_DIR/Source"/>
      </CONFIGURATIONS>
      <MODULEPATHS>
        <MODULEPATH id="juce_audio_basics" path="JUCE_MODULES"/>
        <MODULEPATH id="juce_audio_devices" path="JUCE_MODULES"/>
        <MODULEPATH id="juce_audio_formats" path="JUCE_MODULES"/>
        <MODULEPATH id="juce_audio_processors" path="JUCE_MODULES"/>
        <MODULEPATH id="juce_audio_processors_headless" path="JUCE_MODULES"/>
        <MODULEPATH id="juce_core" path="JUCE_MODULES"/>
        <MODULEPATH id="juce_data_structures" path="JUCE_MODULES"/>
        <MODULEPATH id="juce_events" path="JUCE_MODULES"/>
        <MODULEPATH id="juce_graphics" path="JUCE_MODULES"/>
        <MODULEPATH id="juce_gui_basics" path="JUCE_MODULES"/>
        <MODULEPATH id="juce_gui_extra" path="JUCE_MODULES"/>
      </MODULEPATHS>
    </XCODE_MAC>
  </EXPORTFORMATS>
</JUCERPROJECT>
